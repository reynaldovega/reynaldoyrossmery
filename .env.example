# Solo servidor. Copiar a .env local; nunca subir credenciales a GitHub.
PORT=8787
PUBLIC_ORIGIN=http://127.0.0.1:8787
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
# 32 bytes aleatorios en hexadecimal (64 caracteres). Mantener entre despliegues.
MEMORIES_SESSION_KEY=
# Mantener false hasta comprobar carga, recuperación y aislamiento en producción.
MEMORIES_ENABLED=false
